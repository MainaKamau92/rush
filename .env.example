# Optional Compose override. No .env file or live credentials are needed for setup.
# The app's state directory and environment are supplied inside the container.
RUSH_PORT=8088

# Only the explicit compose.model-access.yaml override forwards this credential.
META_AI_KEY=

# Only compose.source-access.yaml forwards these. IDs stay local; never commit them.
# Approved guidelines use DOCUMENT_ID/PAGE_ID; separate several items with commas.
RUSH_CLICKUP_WORKSPACE_ID=
# Optional personal token; without it rush source-connect uses OAuth.
CLICK_UP_API_TOKEN=
RUSH_APPROVED_GUIDELINES=
RUSH_SOURCE_DISCLOSURE=private

# Only compose.github.yaml forwards these. Keep the app key outside the checkout.
RUSH_GITHUB_APP_ID=
RUSH_GITHUB_PRIVATE_KEY_PATH=
RUSH_GITHUB_WEBHOOK_SECRET=
# OWNER/NAME of each repository rush may review, separated by commas.
RUSH_GITHUB_REPOSITORIES=
RUSH_GITHUB_MENTION=rush-reviewer
RUSH_REVIEW_MAX_FILES=20
RUSH_REVIEW_MAX_CHANGED_LINES=1000
RUSH_REVIEW_SOURCE_BYTES=131072
RUSH_REVIEW_MAX_MODEL_CALLS=60
RUSH_REVIEW_WALL_SECONDS=600
RUSH_REVIEW_IGNORE=*.lock,**/package-lock.json,**/pnpm-lock.yaml,*.min.js,*.min.css,*.map,**/dist/**,**/build/**,**/generated/**,*.png,*.jpg,*.jpeg,*.gif,*.webp,*.ico,*.woff*
RUSH_REVIEW_LOW_PRIORITY=docs/**,knowledge/**,**/*.md,**/verification/**

# Approved rules and exceptions live in this folder, mounted at /policy/team.
RUSH_TEAM_POLICY_DIR=
RUSH_REVIEW_RULES_FILE=
RUSH_REVIEW_EXCEPTIONS_FILE=
RUSH_REVIEW_APPROVERS=
# Classification of the reviewed code; the team must approve it in skills/approved.json.
RUSH_REVIEW_DISCLOSURE=private
# Who reads PR comments: public withholds text drawn from unpublishable sources.
RUSH_GITHUB_AUDIENCE=public
# Team wording defaults for initial inline findings and /rush explain replies.
RUSH_EXPLAIN_COMPLEXITY=plain
RUSH_EXPLAIN_VERBOSITY=short
# GitHub logins or local names allowed to approve team learning, comma-separated.
RUSH_LEARNING_APPROVERS=
