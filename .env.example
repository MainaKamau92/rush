# Optional Compose override. No .env file or live credentials are needed for setup.
# The app's state directory and environment are supplied inside the container.
RUSH_PORT=8088

# Only the explicit compose.model-access.yaml override forwards this credential.
META_AI_KEY=

# Only compose.source-access.yaml forwards these. IDs stay local; never commit them.
# Approved guidelines use DOCUMENT_ID/PAGE_ID; separate several items with commas.
RUSH_CLICKUP_WORKSPACE_ID=
# Optional personal token; without it rush source-connect uses OAuth.
CLICK_UP_API_TOKEN=
RUSH_APPROVED_TICKETS=
RUSH_APPROVED_GUIDELINES=
